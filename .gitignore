app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle sinh android/build/ khi build native (widget, plugin). Khác /build/ ở
# gốc nên dòng trên không bắt được.
/android/build/
/android/.gradle/
# Phiên tạm của Kotlin compiler, tự sinh mỗi lần build.
/android/.kotlin/
