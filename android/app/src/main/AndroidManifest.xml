<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Bắn thông báo kèm nút phân loại nhanh cho mỗi giao dịch mới. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Giữ luồng đọc thông báo sống khi user vuốt app khỏi recents. Không có
         foreground service thì engine Flutter chết theo activity và app không
         ghi được giao dịch nào nữa cho tới lúc mở lại. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Bật lại việc theo dõi sau khi khởi động máy. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Máy để yên lâu thì Android giết service nền; xin miễn tối ưu pin. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Từ Android 15, thông báo biến động số dư bị coi là nhạy cảm và nội
         dung bị giấu với app đọc thông báo. Quyền này chỉ cấp được bằng adb
         (xem màn Ngân hàng), nhưng phải khai ở đây thì lệnh mới ăn. -->
    <uses-permission
        android:name="android.permission.RECEIVE_SENSITIVE_NOTIFICATIONS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:label="Ting Ting"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Nhận nút bấm trên thông báo của app (Chi tiêu / Cho vay / ...). -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false" />

        <!-- Ô tổng quan thu chi ngoài màn hình chính. -->
        <!-- exported="true": launcher của một số hãng (MIUI/HyperOS) tự quét
             receiver để dựng danh sách widget, để "false" thì ô không hiện ra
             trong khay chọn. Receiver này chỉ vẽ lại chữ đã lưu sẵn nên không
             có gì để lộ. -->
        <receiver
            android:name=".SummaryWidgetProvider"
            android:label="@string/widget_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/summary_widget_info" />
        </receiver>

        <!-- Giữ một engine Flutter sống độc lập với màn hình để chạy luồng
             đọc thông báo. Tên class do plugin quy định, không được đổi.
             stopWithTask="false": vuốt app khỏi recents thì service ở lại. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Đọc thông báo ngân hàng để ghi sổ thu chi tự động" />
        </service>

        <!-- Lắng nghe notification của các app khác (app ngân hàng).
             User phải tự bật trong Settings > Notification access. -->
        <service
            android:name="notification.listener.service.NotificationListener"
            android:label="Đọc thông báo ngân hàng"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
