<?xml version="1.0" encoding="utf-8"?>
<!-- Ô lớn ngoài màn hình chính. Chỉ dùng các view mà RemoteViews cho phép
     (LinearLayout / TextView / ImageView) — View thường sẽ không inflate được. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widget_text_dim"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/widget_empty_label"
        android:textColor="@color/widget_text_dim"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/widget_empty_value"
        android:textColor="@color/widget_text"
        android:textSize="32sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeMaxTextSize="32sp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_income_label"
                android:textColor="@color/widget_text_dim"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_value"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_net_label"
                android:textColor="@color/widget_text_dim"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_net"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_value"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_balance_label"
                android:textColor="@color/widget_text_dim"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_empty_value"
                android:textColor="@color/widget_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
